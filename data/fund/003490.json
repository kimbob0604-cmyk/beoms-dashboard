ny/16/20261016_company_267824000.pdf","s":[[["인건비","마진"],"영업비용: 인건비 당사 추정치 대비 약 500억원 상회."],[["인건비"],"[3Q26 Review] 2Q 성과급 미반영분 반영"],[["운반비"],"여객: 141원의 견조한 운임 유지."]]},{"d":"2026-10-16","b":"하나증권","t":"3Q26 Re: 인건비에 깜짝 놀랐지만 여전히 견조한 체력","id":96800,"pdf":"https://stock.pstatic.net/stock-research/company/57/20261016_company_113027000.pdf","s":[[["인건비","운반비"],"국제선 운임과 화물 운임이 예상치 대비 낮았고, 성과급이 일시 집행된 까닭이다."],[["원가","운반비"],"항공화물 매출액은 전년 대비 34% 증가했고, 운임도 28% 상승한 629원/km을 기록했는데, 환율 하락과 유류할증료 감소와 비수기 물동량 둔화가 모두 영향을 주었다."],[["인건비","마진"],"유류비 외에도 인건비가 전년 동기 대비 1,400억원 증가했는데, 상반기 적게 계상했던 성과급이 추가 반영되면서 전체 영업 비용은 27% (YoY) 증가했다."]]},{"d":"2026-10-16","b":"미래에셋증권","t":"단가 상승이 연료비 증가를 상쇄","id":96790,"pdf":"https://stock.pstatic.net/stock-research/company/56/20261016_company_656209000.pdf","s":[[["원가","마진"],"3Q26 Review: 비용증가를 상쇄한 단가 상승"],[["인건비","마진"],"연료비(1조 6,902억원, +67.0% YoY)와 인건비(18% YoY)가 비용 증가를 주도했다."],[["원가"],"단가 상승이 연료비 증가를 상쇄"]]},{"d":"2026-10-16","b":"유안타증권","t":"비용 부담에도 확인된 이익 체력","id":96789,"pdf":"https://stock.pstatic.net/stock-research/company/18/20261016_company_334360000.pdf","s":[[["인건비","마진"],"국제선 여객과 항공화물은 높은 성장세를 이어갔으나, 유가 상승에 따른 연료비 부담과 성과급·명절상여 인식 시점 차이에 따른 인건비 증가가 수익성 개선폭을 제한."],[["마진"],"비용 부담에도 확인된 이익 체력"],[["마진"],"동사 3Q26 별도 매출액과 영업이익은 각각 5조 448억원(YoY +25.9%), 4,212억원(YoY +11.9%, OPM 8.3%)을 기록."]]}],"2026-06-30":[{"d":"2026-09-09","b":"미래에셋증권","t":"통합을 앞두고 나타난 원화 강세","id":96044,"pdf":"https://stock.pstatic.net/stock-research/company/56/20260909_company_620313000.pdf","s":[[["원가"],"3Q26 국제노선 RPK는 8.3% YoY 증가하고, 객단가(Yield) 역시 9.1% YoY 상승할 전망이다."],[["마진"],"영업이익률은 6.7%로 전년 동기(2.6%) 대비 4.1%p, 전분기(-2.9%) 대비 9.6%p 개선될 것으로 추정한다."]]}]},"cns":{"as_of":"2026-11-20","next":[],"base":{"var":{"판매수수료":0.01027,"지급수수료":0.0348,"기타":0.61759},"fix":{"지급임차료":240.7,"감가상각비":7882.9,"인건비":13604.5},"cost":70231.5,"op":2964.2,"opm":4.05}},"earn":{"2023-03-31":{"ts":"2023-05-03 15:58:27","s":31959.0,"se":36018.0,"sr":-0.1127,"st":"miss","o":4150.0,"oe":4768.0,"or":-0.1296,"ot":"miss",