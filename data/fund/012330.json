.pstatic.net/stock-research/company/18/20261102_company_39801000.pdf","s":[[["원가","마진"],"전사 OPM의 하락 (5.8%, -0.2% qoq)은 AS부문의 평균환율 하락 영향 추정."],[["원가","마진"],"전장 중심의 믹스 개선이 원재료비 상승을 상쇄할 수 있었다는 점은 전동화 사업의 수익성 개선세를 암시."],[["원가"],"3Q26Re: 환율에 비틀려도, 상방은 로봇으로"]]},{"d":"2026-11-02","b":"미래에셋증권","t":"3Q26: 제조 흑자 지속, BD 모멘텀 수혜","id":97448,"pdf":"https://stock.pstatic.net/stock-research/company/56/20261102_company_15354000.pdf","s":[[["원가"],"다만 영업외단에서는 환율 하락에 따른 외환손익 감소와 주요 관계사 지분법 이익 감소 영향이 컸다."],[["원가"],"관세 15% 적용으로 관세 기저가 약 +200억 이상이었을 것으로 추정되며, 환율/ASP 효과는 약 +300억원 이상 기여했을 것으로 보인다."],[["마진"],"인도 비용 선반영에도 제조 흑자 지속."]]},{"d":"2026-11-02","b":"iM증권","t":"흑자로 돌아선 제조, 수주로 넘어간 로보틱스","id":97413,"pdf":"https://stock.pstatic.net/stock-research/company/61/20261102_company_616637000.pdf","s":[[["마진"],"26년 3분기, 제조부문 수익성 정상화 지속"],[["마진"],"현대모비스의 3Q26 매출액은 15조 7,233억원(YoY +4.6%), 영업이익은 9,141억원(YoY +17.2%), OPM 5.8%(YoY +0.6%p)를 기록했다."],[["마진"],"인도 공장 화재와 메모리 반도체 비용 부담에도 제조부문의 본원 수익성이 개선되고 있다는 점이 긍정적이다."]]}]},"cns":{"as_of":"2026-11-20","next":[],"base":{"var":{"운반비":0.04193,"지급수수료":0.02273,"기타":0.04345,"원가":0.72991,"광고선전비":0.00198},"fix":{"감가상각비":3242.5,"인건비":12857.4},"cost":148175.5,"op":9057.6,"opm":5.76}},"earn":{"2023-03-31":{"ts":"2023-04-26 10:04:25","s":146670.0,"se":134773.0,"sr":0.0883,"st":"beat","o":4181.0,"oe":5740.0,"or":-0.2716,"ot":"miss","case":"miss"},"2023-06-30":{"ts":"2023-07-27 10:05:52","s":156849.0,"se":153139.0,"sr":0.0242,"st":"inline","o":6637.0,"oe":6395.0,"or":0.0378,"ot":"inline","case":"inline"},"2023-09-30":{"ts":"2023-10-27 09:58:27","s":142302.0,"se":152892.0,"sr":-0.0693,"st":"miss","o":6902.0,"oe":6917.0,"or":-0.0022,"ot":"inline","case":"inline"},"2023-12-31":{"ts":"2024-01-26 09:56:04","s":146722.0,"se":152487.0,"sr":-0.0378,"st":"inline","o":5232.0,"oe":6699.0,"or":-0.219,"ot":"miss","case":"miss"},"2024-03-31":{"ts":"2024-04-26 09:59:19","s":138692.0,"se":143336.0,"sr":-0.0324,"st":"inline","o":5427.0,"oe":6214.0,"or":-0.1266,"ot":"miss","case":"miss