atic.net/stock-research/company/62/20260929_company_420577000.pdf","s":[[["광고선전비","마진"],"2분기 대비 1) 중동발 원부자재 비용 부담이 QoQ 200억원 증가, 2) 북미/중국 마케팅 투자 확대, 3) 아마존 프라임데이 행사 부재 등 부담 요인 존재."],[["광고선전비","마진"],"수익성도 닥터그루트의 판매 채널이 코스트코에서 세포라로 전환하는 과정에서 마케팅비 투자가 확대되고 있는 것으로 파악됨."],[["광고선전비"],"영업적자는 4분기 행사 앞두고 마케팅 투자 확대와 계절적 비수기 영향으로 QoQ 확대될 전망."]]}],"2026-06-30":[{"d":"2026-08-25","b":"한화투자증권","t":"Avon 매각 코멘트: 자신감 붙은 북미 사업","id":95866,"pdf":"https://stock.pstatic.net/stock-research/company/16/20260825_company_113978000.pdf","s":[[["인건비","운반비"],"LG생활건강은 인수 당시 Avon 브랜드 자체뿐 아니라 북미 내 IT·구매·물류·영업 인프라와 전문 인력을 확보하고, 이를 LG생활건강 브랜드의 미국 진출 교두보로 활용한다는 계획을 제시했다."]]},{"d":"2026-08-05","b":"한화투자증권","t":"높아진 실적 가시성","id":95086,"pdf":"https://stock.pstatic.net/stock-research/company/16/20260805_company_575658000.pdf","s":[[["마진"],"중국은 신제품 프로모션 영향으로 적자가 이어졌지만, 면세는 천기단 외 SKU와 FIT 수요 확대에 힘입어 전분기 대비 회복됐으며, 구조조정 효과로 두 자릿수 영업이익률을 유지했다."]]}]},"cns":{"as_of":"2026-11-24","next":[{"p":"2026-12-31","pl":"4Q26","sales":14759.0,"op":247.0,"m":{"var":{"외주비":0.05625,"기타":0.1729,"지급수수료":0.15494,"원가":0.40418},"fix":{"감가상각비":548.8,"인건비":2167.7},"cost":14350.7,"op":408.3,"opm":2.77}}],"base":{"var":{"외주비":0.05625,"기타":0.1729,"지급수수료":0.15494,"원가":0.40418},"fix":{"감가상각비":548.8,"인건비":2167.7},"cost":15150.5,"op":623.2,"opm":3.95}},"earn":{"2023-03-31":{"ts":"2023-04-27 15:40:41","s":16837.0,"se":17231.0,"sr":-0.0229,"st":"inline","o":1459.0,"oe":1731.0,"or":-0.1571,"ot":"miss","case":"miss"},"2023-06-30":{"ts":"2023-07-27 15:35:28","s":18077.0,"se":18914.0,"sr":-0.0443,"st":"inline","o":1578.0,"oe":1981.0,"or":-0.2034,"ot":"miss","case":"miss"},"2023-09-30":{"ts":"2023-10-26 15:33:41","s":17462.0,"se":18474.0,"sr":-0.0548,"st":"miss","o":1285.0,"oe":1550.0,"or":-0.171,"ot":"miss","case":"miss"},"2023-12-31":{"ts":"2024-01-31 15:51:05","s":15672.0,"se":17140.0,"sr":-0.0856,"st":"miss","o":547.0,"oe":578.0,"or":-0.0536,"ot":"inline","case":"inline"},"2024-03-31":{"ts":"2024-04-25 15:39:25","s":17287.0,"se":16833.0,"sr