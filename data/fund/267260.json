/company/57/20261028_company_829180000.pdf","s":[[["원가"],"환율 하락과 국내 매출 비중 증가로 이익률이 하락했지만 매출은 단일 분기 기준 최대치를 기록했다."],[["마진"],"매출 Mix 변화로 인한 마진 약화"]]},{"d":"2026-10-28","b":"유안타증권","t":"빅테크 수요가 이끄는 추가 증설","id":97154,"pdf":"https://stock.pstatic.net/stock-research/company/18/20261028_company_707888000.pdf","s":[[["원가","마진"],"다만 북미 사업의 영업이익률은 3개 분기 연속 개선됐으며, 신규 수주 판가도 상승세를 유지하고 있다."],[["감가상각비"],"빅테크 수요가 이끄는 추가 증설"],[["원가"],"환율 하락도 일부 부담으로 작용했다."]]},{"d":"2026-10-28","b":"대신증권","t":"지나간 실적보다, 긍정적 사업 전략 구체화에 주목","id":97145,"pdf":"https://stock.pstatic.net/stock-research/company/15/20261028_company_820140000.pdf","s":[[["감가상각비"],"AIDC 직납용 배전변압기 증설은 긍정적"],[["원가"],"원/달러 환율 하락에 따른 실적 전망치 하향 조정, 6개월 내 목표주가 현실화 등을 반영했기 때문."],[["감가상각비"],"업황은 여전히 견조하며, 신규 청주 배전용 변압기 증설, 초고압 변압기(154~345kV)와 배전용 변압기, HD현대중공업의 중속엔진향 발전기(동사 사업부 기준으로는 회전기기에 포함)의 패키지 공급 등을 통해 AI데이터센터 직납 물량 확대는 긍정적."]]},{"d":"2026-10-28","b":"SK증권","t":"외형 성장 지속","id":97140,"pdf":"https://stock.pstatic.net/stock-research/company/64/20261028_company_637245000.pdf","s":[[["마진"],"3Q26 Review: 외형은 성장, 수익성은 모멘텀 둔화"],[["마진"],"3Q26은 매출액 1조 1,799억원(YoY +18.5%), 영업이익 2,845억원(YoY +15.2%, OPM 24.1%)을 기록했다."],[["마진"],"수익성 둔화는 (1) 국내 매출 비중이 22.5%에서 약 31%로 증가한 점과 (2) 원화 강세가 영향을 미친 것으로 추정한다."]]},{"d":"2026-10-28","b":"신한투자증권","t":"환율이 깎은 3분기, 증설이 여는 2027년","id":97128,"pdf":"https://stock.pstatic.net/stock-research/company/21/20261028_company_980836000.pdf","s":[[["원가","감가상각비"],"환율이 깎은 3분기, 증설이 여는 2027년"],[["감가상각비"],"숫자는 쉬어 가고, 증설은 속도를 낸다"]]}],"2026-06-30":[{"d":"2026-08-24","b":"SK증권","t":"수익성은 유틸리티, 성장은 증설이 만든다","id":95818,"pdf":"https://stock.pstatic.net/stock-research/company/64/20260824_company_28043000.pdf","s":[[["감가상각비","수도광열비","마진"],"수익성은 유틸리티, 성장은 증설이 만든다"],[["수도광열비"],"초고압 변압기는 유틸리티향 장주기 수주 비즈니스로 고수익을 창출하고 있고, 배전은 납기가 짧고 회전이 빨라서 매출액 성장성과 사이클 후반의 방어력을 보여줄 수 있다."]]}]},"cns":{"as_of":"2026-11-27","next":[{"p":"2026-12-31","pl":"4Q26","sales":12828.0,"op":3412.0,"m":{"var":{"원가":0.48701,"기타":0.16028},"fix":{"감가상각비":193.8,"인건비":562