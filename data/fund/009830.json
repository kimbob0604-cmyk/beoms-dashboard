ny/57/20261030_company_242733000.pdf","s":[[["인건비","마진"],"20개 이상의 EPC 사업의 일부 공기 지연 및 기자재의 불량 이슈, 현장 인력 확보 비용 증가 등 복합적 이슈가 작용한 영향이며, 이는 다음"],[["원가"],"중국의 수출 확대에 따라 주요 제품의 스프레드가 약세를 유지한 가운데, 높은 원재료 가격 투입과 환율 하락에 따른 부정적 래깅효과 때문이다."],[["마진"],"태양광 모듈 출하량은 2.0GW로 QoQ +54% 증가하였으나 마진율은 유사했다."]]},{"d":"2026-10-30","b":"미래에셋증권","t":"단기 실적 우려 있으나, 커지는 중장기 기대감","id":97338,"pdf":"https://stock.pstatic.net/stock-research/company/56/20261030_company_405777000.pdf","s":[[["원가","감가상각비"],"이에 2027년에는 AMPC 증가뿐 아니라 제품 믹스 개선과 고정비 부담 완화가 이익 회복을 뒷받침할 것으로 판단한다."],[["원가"],"다만 1) Section 232 발효에 따른 모듈 가격 상승, 2) DCA 모듈 판매 확대에 따른 제품 믹스 개선, 3) 주택용 부문의 성장성을 고려하면 2027년 실적은 크게 개선될 전망이다."],[["원가"],"특히 카터스빌의 2027년 DCA 모듈 물량은 이미 판매 완료됐으며, 달튼 모듈과의 번들 판매는 전체 미국 생산설비의 가동률 개선으로 이어질 수 있다."]]},{"d":"2026-10-30","b":"유진투자증권","t":"올해보다 내년","id":97310,"pdf":"https://stock.pstatic.net/stock-research/company/63/20261030_company_547601000.pdf","s":[[["원가","인건비"],"20개 이상 프로젝트가 동시 진행되며 공기지연, 벤더 기자재 불량 수리, AIDC 건설 붐에 따른 인력난이 원가 부담으로 작용했다."],[["원가","인건비"],"그러나 미국 EPC 인력난에 따른 공기지연과 원가 상승, 유럽 및 미국 일부 프로젝트의 손익 부담이 지속되어 영업이익은 기존 가이던스를 하회할 전망이다."],[["원가"],"다만, 12월 4일 Section 232 최종 조치 이후 모듈 판가 상승이 2027년부터 본격화되고, 카터스빌 통합 생산(잉곳~모듈)에 따른 AMPC(생산세액보조금) 확대와 DCA(내수 소재/부품 보조금) 프리미엄이 가시화될 것으로 기대된다."]]}]},"cns":{"as_of":"2026-11-20","next":[{"p":"2026-12-31","pl":"4Q26","sales":44272.0,"op":985.0,"m":{"var":{"수도광열비":0.01989,"외주비":0.06822,"운반비":0.01343,"기타":0.14666,"원가":0.60754},"fix":{"지급임차료":46.3,"감가상각비":962.0,"인건비":1184.4},"cost":40078.1,"op":4193.9,"opm":9.47}}],"base":{"var":{"수도광열비":0.01989,"외주비":0.06822,"운반비":0.01343,"기타":0.14666,"원가":0.60754},"fix":{"지급임차료":46.3,"감가상각비":962.0,"인건비":1184.4},"cost":17513.0,"op":389.9,"opm":2.18}},"earn":{"2023-03-31":{"ts":"2023-04-27 12:57:44","s":31002.0,"se":31741.0,"sr":-0.0233,"st":"inline","o":2714.0,"oe":2252.0,"or":0.2052,"ot":"beat","case":"op"},"2023-06-30":{"ts":"2023-07-27 13:23:13","s":33930.0,"se":30901.0,"sr":0.098,"st":"beat","o":1940.0,"oe":2483.0,"or":-0.2187,"ot":"miss","cas