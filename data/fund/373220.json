rch/company/66/20261104_company_704445000.pdf","s":[[["원가"],"유럽 고전압 미드니켈 출하 확대와 폴란드 가동률 개선으로 자동차 적자 폭도 보상금 제외 크게 줄었다."]]},{"d":"2026-11-04","b":"하나증권","t":"확실한 공급자 우위 시장 확인","id":97590,"pdf":"https://stock.pstatic.net/stock-research/company/57/20261104_company_597739000.pdf","s":[[["감가상각비","마진"],"상반기 -10% 내외 적자율이었던 것으로 추정되는 부문 영업이익률은 물량 증가 및 고정비 부담 완화 힘입어 3분기 적자율 -5% 미만까지 축소된 것으로 추정된다(AMPC 제외기준)."],[["마진"],"수익성의 경우, 고객사로부터 물량 보전 보상금 수취하며 한 자릿수 후반대의 영업이익률 기록한 것으로 추정된다."],[["마진"],"부문 영업이익률은 중국 정부의 배터리 소비세 과세 재개로 세부담 증가했으나, 한 자릿수대 후반 수준의 영업이익률 방어한 것으로 추정된다."]]},{"d":"2026-11-04","b":"IBK투자증권","t":"ESS 중심의 성장축 전환","id":97573,"pdf":"https://stock.pstatic.net/stock-research/company/40/20261104_company_352766000.pdf","s":[[["마진"],"LG에너지솔루션의 3Q26 매출액은 9조 6,434억원(YoY +59.0%, QoQ +27.6%), 영업이익은 7,560억원(YoY +25.7%, QoQ +567.3%), OPM 7.8%를 기록하며 시장 기대치를 상회했다."],[["마진"],"북미 생산보조금은 4,169억원으로 ESS 전력망향 판매 증가에 힘입어 전분기 대비 73% 증가했으며, 이를 제외한 영업이익은 3,391억원, OPM 3.7%를 기록했다."]]}],"2026-06-30":[{"d":"2026-08-05","b":"대신증권","t":"명확한 방향성","id":95066,"pdf":"https://stock.pstatic.net/stock-research/company/15/20260805_company_890085000.pdf","s":[[["마진"],"예상대비 ESS 매출 반영/수익성 개선 지연된 점은 아쉬우나, 2Q26를 저점으로 2H26~2027년 실적 개선 지속될 것."]]}]},"cns":{"as_of":"2026-11-24","next":[{"p":"2026-12-31","pl":"4Q26","sales":101808.0,"op":4394.0,"m":{"var":{"기타":0.23985,"광고선전비":0.00076,"지급수수료":0.05466,"운반비":0.00643,"원가":0.43686},"fix":{"감가상각비":12114.9,"지급임차료":107.2,"인건비":8990.0},"cost":96403.6,"op":5404.4,"opm":5.31}}],"base":{"var":{"기타":0.23985,"광고선전비":0.00076,"지급수수료":0.05466,"운반비":0.00643,"원가":0.43686},"fix":{"감가상각비":12114.9,"지급임차료":107.2,"인건비":8990.0},"cost":92434.8,"op":3999.5,"opm":4.15}},"earn":{"2023-03-31":{"ts":"2023-04-07 10:52:50","s":87471.0,"se":83707.0,"sr":0.045,"st":"inline","o":6332.0,"oe":4847.0,"or":0.3064,"ot":"beat","case":"op"},"2023-06-30":{"ts":"2023-07-07 15:23:46","s":87735.0,"se":87240.0,"sr":0.0057,"st":"inline","o":6116.0,"oe":6921.0,"or":-0.1163,"ot":"miss","case":"miss"},"2023-09-30":{"