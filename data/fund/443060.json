ck-research/company/64/20261027_company_679470000.pdf","s":[[["원가","인건비","마진"],"전사 OPM 하락은 일회성 비용과 더불어 2 분기 중동발 공급망 차질로 감소했던 벙커링 부문 매출액 기저효과에 따른 결과이며, 이번 분기 Goltens 인수 관련 90 억원 및 환율 하락으로 인한 약 60 억원 내외의 일회성 비용 발생했다."],[["원가"],"AM 솔루션 부문의 장기 성장동력인 DF 엔진 비중이 최근 16%까지 확대됨에 따라 ASP 상승에 따른 매출 성장 지속될 전망이다."],[["마진"],"이를 제거한 경상 영업이익은 컨센서스를 상회했으며, 핵심사업부문은 매출액 3,565억원, 영업이익 952억원(OPM 26.7%), 경상 OPM 약 30.9%로, 전분기 대비 견조한 이익 성장세 시현 중이다."]]},{"d":"2026-10-15","b":"삼성증권","t":"Goltens 인수, 서비스 인프라 확보를 위한 합리적 결정","id":96752,"pdf":"https://stock.pstatic.net/stock-research/company/78/20261015_company_433170000.pdf","s":[[["인건비"],"Goltens는 85년 업력의 엔진 서비스 업체로, 전 세계 15개국, 28개 수리 거점과 약 1.3천 명의 서비스 인력을 보유."],[["인건비"],"대규모 서비스 인력의 확보와 육성에 걸리는 시간을 고려할 필요."],[["감가상각비"],"수주 급증으로 인한 높은 기저와 중국 조선사들의 증설로, 조선업황 피크아웃 우려가 반영되고 있는 것."]]}]},"cns":{"as_of":"2026-11-27","next":[{"p":"2026-12-31","pl":"4Q26","sales":6390.0,"op":1078.0,"m":{"var":{"원가":0.6473,"기타":0.12585},"fix":{"감가상각비":50.7,"인건비":292.0},"cost":5283.2,"op":1106.8,"opm":17.32}}],"base":{"var":{"원가":0.6473,"기타":0.12585},"fix":{"감가상각비":50.7,"인건비":292.0},"cost":5369.1,"op":1132.1,"opm":17.41}},"earn":{"2024-09-30":{"ts":"2024-10-23 13:34:56","s":4613.0,"se":3769.0,"sr":0.2239,"st":"beat","o":834.0,"oe":577.0,"or":0.4454,"ot":"beat","case":"both"},"2024-12-31":{"ts":"2025-02-04 14:39:55","s":4634.0,"se":4722.0,"sr":-0.0186,"st":"inline","o":659.0,"oe":859.0,"or":-0.2328,"ot":"miss","case":"miss"},"2025-03-31":{"ts":"2025-04-24 14:46:01","s":4856.0,"se":4619.0,"sr":0.0513,"st":"beat","o":830.0,"oe":760.0,"or":0.0921,"ot":"inline","case":"sales"},"2025-06-30":{"ts":"2025-07-24 14:16:22","s":4677.0,"se":4998.0,"sr":-0.0642,"st":"miss","o":830.0,"oe":859.0,"or":-0.0338,"ot":"inline","case":"inline"},"2025-09-30":{"ts":"2025-10-30 14:37:24","s":5132.0,"se":5247.0,"sr":-0.0219,"st":"inline","o":936.0,"oe":968.0,"or":-0.0331,"ot":"inline","case":"inline"},"2025-12-31":{"ts":"2026-02-04 15:26:06","s":5162.0,"se":5193.0,"sr":-0.006,"st":"inline","o":905