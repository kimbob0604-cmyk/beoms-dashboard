:"2026-11-06","broker":"유진투자증권","s":"\" [투자포인트 ①] 동해 AIDC 잠재 테넌트와 협상은 예정된 스케줄로 진행 중이며 연말~내년 초 1단계 계약 추진을 목표"},{"id":95471,"date":"2026-08-12","broker":"유진투자증권","s":"현재 복수의 테넌트와 협의를 진행 중이라 언급했으며, 1.2GW는 일괄 착공이 아닌 테넌트별 단계별 착공(예: Phase1 150MW → Phase2 150MW)이 예상된다고 언급"}]},{"kw":"무난","n":2,"hits":[{"id":97769,"date":"2026-11-06","broker":"유진투자증권","s":"GS E&R 및 기타 사업은 특이사항이 없는 무난한 실적 달성"},{"id":95471,"date":"2026-08-12","broker":"유진투자증권","s":"반면, EPS(가스 발전)은 개별요금제 종료로 적자 전환했으며, 기타 사업부도 무난한 실적을 유지"}]}],"reports":[{"id":97769,"d":"2026-11-06","b":"유진투자증권","t":"AIDC, 한국으로 풍선효과 기대","op":"매수","g":113000.0,"pg":138000.0,"p":76800.0,"h":[],"kw":["윤활유","정유","정제마진"],"pdf":"https://stock.pstatic.net/stock-research/company/63/20261106_company_394395000.pdf"},{"id":95471,"d":"2026-08-12","b":"유진투자증권","t":"땅, 물, 전력을 다 가진 AIDC 성장주","op":"매수","g":138000.0,"pg":null,"p":97500.0,"h":[],"kw":["동해","정유","GW"],"pdf":"https://stock.pstatic.net/stock-research/company/63/20260812_company_2401000.pdf"}],"flow":[["2026-11-06",-185.2,166.3,17.4,76900.0,21.39],["2026-11-05",28.5,-27.1,-5.6,76800.0,21.65],["2026-11-04",44.2,-50.5,0.3,78900.0,21.69],["2026-11-03",65.2,-55.5,-10.1,77800.0,21.63],["2026-11-02",-30.4,2.8,26.5,82900.0,21.53],["2026-10-30",2.4,20.4,-21.6,81000.0,21.58],["2026-10-29",0.6,-53.6,48.0,82600.0,21.58],["2026-10-28",-25.1,-60.1,85.3,82300.0,21.59],["2026-10-27",153.0,-102.3,-53.8,79500.0,21.64],["2026-10-26",129.4,12.8,-143.2,78700.0,21.45],["2026-10-23",161.9,16.5,-181.5,85600.0,21.26],["2026-10-22",109.6,-94.4,-16.4,88100.0,21.13],["2026-10-21",8.9,-11.1,2.0,91000.0,20.99],["2026-10-20",129.5,-85.6,-47.2,89000.0,20.98],["2026-10-19",38.0,-40.6,-2.3,93800.0,20.84],["2026-10-16",40.5,-70.6,27.4,93000.0,20.81],["2026-10-15",96.6,-46.3,-55.1,94400.0,20.77],["2026-10-14",-0.5,5.9,-1.0,100500.0,20.65],["2026-10-13",-71.8,92.5,-23.6,99500.0,20.64],["2026-10-12",70.8,-31.9,-39.1,100800.0,20.72]]}