<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Beom's Dashboard 갱신: 1분마다 live.py (시간대별로 할 일만 하고, 할 일이 없으면 바로 끝남. 앞 실행이 돌고 있으면 건너뜀).
     2026-11-19 10분 → 1분 (배포는 Actions 워크플로라 시간당 10회 한도 없음). 설치: README 참고 -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kimbob.beomdashboard.live</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/beomjun/Beom's Dashboard/live.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/beomjun/Beom's Dashboard</string>

    <key>StartInterval</key>
    <integer>60</integer>

    <!-- 로그인(재부팅) 직후 기다리지 않고 바로 한 번 -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/beomjun/Beom's Dashboard/logs/launchd.live.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/beomjun/Beom's Dashboard/logs/launchd.live.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LANG</key>
        <string>ko_KR.UTF-8</string>
    </dict>
</dict>
</plist>
